[gd_resource type="Resource" script_class="DisplayCard" load_steps=9 format=3]

[ext_resource type="Script" path="res://link.gd" id="1_thgi6"]
[ext_resource type="Script" path="res://variable_manipulation.gd" id="2_c3jp3"]
[ext_resource type="Script" path="res://display_card.gd" id="2_exbke"]

[sub_resource type="Resource" id="Resource_exbke"]
script = ExtResource("2_c3jp3")
type_name = 1
var_name = "cake"
value = true

[sub_resource type="Resource" id="Resource_c3jp3"]
script = ExtResource("1_thgi6")
description = "I eat some cake from the fridge."
destination = "res://cards/card2.tres"
condition = "cake != true"
set_vars = Array[ExtResource("2_c3jp3")]([SubResource("Resource_exbke")])

[sub_resource type="Resource" id="Resource_sx8kg"]
script = ExtResource("1_thgi6")
description = "I peak out the window"
destination = "res://cards/card3.tres"

[sub_resource type="Resource" id="Resource_ha1c4"]
script = ExtResource("1_thgi6")
description = "I hide behind my house plant"
destination = "res://cards/card4.tres"

[sub_resource type="Resource" id="Resource_6cys4"]
script = ExtResource("1_thgi6")
description = "Transform!!!"
destination = "res://cards/card6.tres"
condition = "cake == true"

[resource]
script = ExtResource("2_exbke")
description = "You are in the kitchen. Two people are waiting outside ready to arrest you. What do you do?"
options = Array[ExtResource("1_thgi6")]([SubResource("Resource_c3jp3"), SubResource("Resource_sx8kg"), SubResource("Resource_ha1c4"), SubResource("Resource_6cys4")])
position = Vector2(40, -40)
