[resource]
script = ExtResource("3_g7pfr")
description = "You sneeze in a beautiful way. The people inside your home hear your beautiful sneeze and are overcome with such overwhelming catharsis that they need to take a breather outside. As they leave, you feel another sneeze coming on, but you wonder if sneezing a second time is overkill."
options = Array[ExtResource("1_rfldx")]([SubResource("Resource_rfldx"), SubResource("Resource_ki4yx")])
position = Vector2(1120, 380)
