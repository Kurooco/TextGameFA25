[sub_resource type="Resource" id="Resource_rfldx"]
script = ExtResource("1_rfldx")
description = "True sneezes know no boundries! Release the sneeze!"
destination = "res://cards/card9.tres"

[sub_resource type="Resource" id="Resource_ki4yx"]
script = ExtResource("1_rfldx")
description = "Hold in the sneeze. We mush strive for modesty and discipline in our sneezes."
